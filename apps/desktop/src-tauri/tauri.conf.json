{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OverCut",
  "version": "0.1.0",
  "identifier": "io.github.esheliko.overcut",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OverCut",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "overcut"
        ],
        "name": "OverCut project",
        "description": "OverCut project",
        "mimeType": "application/x-overcut",
        "role": "Editor"
      },
      {
        "ext": [
          "mp4",
          "m4v",
          "mov",
          "mkv",
          "webm",
          "avi",
          "mpg",
          "mpeg",
          "ts",
          "mts",
          "m2ts",
          "3gp",
          "wmv",
          "flv",
          "ogv",
          "mp3",
          "m4a",
          "aac",
          "wav",
          "flac",
          "ogg",
          "oga",
          "opus",
          "aif",
          "aiff",
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "bmp",
          "tif",
          "tiff",
          "heic",
          "avif"
        ],
        "name": "Media file",
        "description": "Video, audio or image",
        "role": "Viewer"
      }
    ]
  }
}
