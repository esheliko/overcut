{
  "name": "OverCut",
  "short_name": "OverCut",
  "description": "A free, fast, feature-complete video and media editor for every device and screen: comfortable and quick to use, no watermark, no paywall, no account, everything running on your own device.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0b0d10",
  "theme_color": "#0b0d10",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "video/*": [
          ".mp4",
          ".m4v",
          ".mov",
          ".mkv",
          ".webm",
          ".avi",
          ".mpg",
          ".mpeg",
          ".ts",
          ".mts",
          ".m2ts",
          ".3gp",
          ".wmv",
          ".flv",
          ".ogv"
        ],
        "audio/*": [
          ".mp3",
          ".m4a",
          ".aac",
          ".wav",
          ".flac",
          ".ogg",
          ".oga",
          ".opus",
          ".aif",
          ".aiff"
        ],
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".gif",
          ".webp",
          ".bmp",
          ".tif",
          ".tiff",
          ".heic",
          ".avif"
        ],
        "application/x-overcut": [
          ".overcut"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "video/*",
            "audio/*",
            "image/*",
            ".overcut"
          ]
        }
      ]
    }
  }
}
