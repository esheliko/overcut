{
  "name": "overcut",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": ["apps/web", "apps/desktop", "packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run build:wasm && npm run dev -w @app/web",
    "build": "npm run build:wasm && npm run build -w @app/web",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "tsc -b",
    "lint": "npm run lint:ts && npm run lint:rust",
    "lint:ts": "eslint apps packages scripts tests && node scripts/check-boundaries.mjs && node scripts/build-rules.mjs --check && node scripts/gen-model-types.mjs --check",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "npm run test:ts && npm run test:rust",
    "test:ts": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:rust": "cargo test --workspace",
    "test:e2": "PROPTEST_CASES=10000 cargo test -p app-timeline --release",
    "gen:model-types": "node scripts/gen-model-types.mjs",
    "rules:build": "node scripts/build-rules.mjs",
    "rules:check": "node scripts/build-rules.mjs --check",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "smoke": "node scripts/smoke.mjs",
    "perf": "node tests/perf/run.mjs",
    "perf:compare": "node tests/perf/compare.mjs",
    "perf:device": "node tests/perf/device.mjs",
    "desktop:dev": "npm exec -w @app/desktop tauri dev",
    "desktop:build": "npm exec -w @app/desktop tauri build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
