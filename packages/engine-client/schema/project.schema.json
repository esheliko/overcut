{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/ProjectId"
    },
    "media": {
      "description": "Every media file used by any clip. Clips refer to these by id and never embed paths.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MediaRef"
      }
    },
    "name": {
      "type": "string"
    },
    "schema_version": {
      "description": "The schema this document was written with; readers migrate older versions and refuse newer ones.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Sequence"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "media",
    "sequences"
  ],
  "$defs": {
    "Animated": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Keyframe"
          }
        },
        "value": {
          "description": "The value when there are no keys.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "value"
      ]
    },
    "Clip": {
      "type": "object",
      "properties": {
        "duration": {
          "description": "Length on the timeline (source length is `duration * speed`).",
          "$ref": "#/$defs/Time"
        },
        "id": {
          "$ref": "#/$defs/ClipId"
        },
        "link": {
          "description": "Clips sharing a link edit as one (TL-05, `docs/features/timeline-ops.md`): the picture and the sound of one import. `None` = alone.\nOnly the editing layer acts on it; evaluation and export ignore it. Absent in files made before linking existed.",
          "anyOf": [
            {
              "$ref": "#/$defs/LinkId"
            },
            {
              "type": "null"
            }
          ]
        },
        "media": {
          "$ref": "#/$defs/MediaId"
        },
        "source_in": {
          "description": "Where in the source media the clip starts.",
          "$ref": "#/$defs/Time"
        },
        "speed": {
          "description": "Playback speed, positive. 1/1 in M1.",
          "$ref": "#/$defs/Rational",
          "default": {
            "den": 1,
            "num": 1
          }
        },
        "start": {
          "description": "Where the clip starts on the sequence timeline.",
          "$ref": "#/$defs/Time"
        },
        "transform": {
          "description": "Position, scale, rotation, crop, flip, opacity and fit (M2-003). The identity is the default and is not written.",
          "$ref": "#/$defs/ClipTransform"
        }
      },
      "required": [
        "id",
        "media",
        "start",
        "source_in",
        "duration"
      ]
    },
    "ClipId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "ClipTransform": {
      "description": "Position, scale, rotation, anchor, crop, flip, opacity and fit of one clip. `Default` is the identity.",
      "type": "object",
      "properties": {
        "anchor_x": {
          "description": "The point rotation, scale and flip pivot on, as an offset from the picture centre in picture widths / heights.",
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 0.0
          }
        },
        "anchor_y": {
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 0.0
          }
        },
        "crop_bottom": {
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 0.0
          }
        },
        "crop_left": {
          "description": "Fraction of the source picture removed from each edge, `0..1`; `left + right < 1` and `top + bottom < 1`.",
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 0.0
          }
        },
        "crop_right": {
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 0.0
          }
        },
        "crop_top": {
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 0.0
          }
        },
        "fit": {
          "$ref": "#/$defs/Fit",
          "default": "contain"
        },
        "flip_h": {
          "type": "boolean",
          "default": false
        },
        "flip_v": {
          "type": "boolean",
          "default": false
        },
        "opacity": {
          "description": "`0..=1`.",
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 1.0
          }
        },
        "position_x": {
          "description": "Offset of the anchor from the canvas centre, in canvas widths (+ right). 0 = centred.",
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 0.0
          }
        },
        "position_y": {
          "description": "Offset in canvas heights (+ down).",
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 0.0
          }
        },
        "rotation": {
          "description": "Degrees clockwise around the anchor.",
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 0.0
          }
        },
        "scale_x": {
          "description": "1 = the size `fit` gives. Must be > 0 (flip is separate).",
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 1.0
          }
        },
        "scale_y": {
          "$ref": "#/$defs/Animated",
          "default": {
            "value": 1.0
          }
        }
      }
    },
    "Easing": {
      "oneOf": [
        {
          "description": "Keeps this key's value until the next key (a step).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "hold"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "linear"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "CSS-style `cubic-bezier`; `x1` and `x2` must be in `[0,1]`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bezier"
            },
            "x1": {
              "type": "number",
              "format": "double"
            },
            "x2": {
              "type": "number",
              "format": "double"
            },
            "y1": {
              "type": "number",
              "format": "double"
            },
            "y2": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "x1",
            "y1",
            "x2",
            "y2"
          ]
        }
      ]
    },
    "Fit": {
      "description": "How the picture is first sized into the canvas, before scale applies.",
      "oneOf": [
        {
          "description": "Whole picture visible, bars where the shapes differ (the M1 behaviour).",
          "type": "string",
          "const": "contain"
        },
        {
          "description": "Picture covers the canvas, the overflow is cut off.",
          "type": "string",
          "const": "cover"
        },
        {
          "description": "Picture is stretched to the canvas shape.",
          "type": "string",
          "const": "stretch"
        }
      ]
    },
    "Keyframe": {
      "type": "object",
      "properties": {
        "easing": {
          "description": "Shape of the segment from this key to the next (ignored on the last key).",
          "$ref": "#/$defs/Easing",
          "default": {
            "kind": "linear"
          }
        },
        "t": {
          "description": "Clip-relative time (0 = the clip's first tick on the timeline).",
          "$ref": "#/$defs/Time"
        },
        "v": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "t",
        "v"
      ]
    },
    "LinkId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "MediaId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "MediaKind": {
      "type": "string",
      "enum": [
        "video",
        "audio",
        "image"
      ]
    },
    "MediaRef": {
      "description": "A source file as the project knows it. The bytes live outside the project; `uri` is resolved by the host.",
      "type": "object",
      "properties": {
        "duration": {
          "description": "Source length; `None` for stills and until probed.",
          "anyOf": [
            {
              "$ref": "#/$defs/Time"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hash": {
          "description": "Content hash (hex) used to relink moved files; `None` until computed.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "$ref": "#/$defs/MediaId"
        },
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "name": {
          "type": "string"
        },
        "tags": {
          "description": "Free-form labels the user put on the item in the media bin (`docs/features/media-bin.md`), trimmed, unique, at most `MAX_TAGS`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uri": {
          "description": "Host-resolved locator: a path relative to the project, a file handle key (web) or similar. Opaque to the model.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "uri"
      ]
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "Rational": {
      "description": "An exact fraction (frame rates, speeds). `den` is always positive and the fraction is reduced.",
      "type": "object",
      "properties": {
        "den": {
          "type": "integer",
          "format": "int64"
        },
        "num": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "num",
        "den"
      ]
    },
    "Resolution": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "Sequence": {
      "type": "object",
      "properties": {
        "frame_rate": {
          "$ref": "#/$defs/Rational"
        },
        "id": {
          "$ref": "#/$defs/SequenceId"
        },
        "name": {
          "type": "string"
        },
        "rate_fixed": {
          "description": "Same for `frame_rate`: true once the user picked a frame rate; while false the first picture imported sets it.",
          "type": "boolean"
        },
        "resolution": {
          "$ref": "#/$defs/Resolution"
        },
        "sample_rate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "size_fixed": {
          "description": "True once the user chose the canvas size (an aspect/size preset or a custom one). While false the first picture imported sets\n`resolution` (\"match first clip\", the zero-question default). Absent in older files = false.",
          "type": "boolean"
        },
        "tracks": {
          "description": "Bottom-to-top for video (later tracks draw over earlier ones). Any number of tracks of either kind.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Track"
          }
        }
      },
      "required": [
        "id",
        "name",
        "frame_rate",
        "resolution",
        "sample_rate",
        "tracks"
      ]
    },
    "SequenceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "Time": {
      "description": "A point in time or a duration, in ticks. Serialized as a plain integer.",
      "type": "integer",
      "format": "int64"
    },
    "Track": {
      "type": "object",
      "properties": {
        "clips": {
          "description": "Sorted by `start`, never overlapping (see [`Project::validate`]).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clip"
          }
        },
        "colour": {
          "description": "Label colour as `#rrggbb`; `None` = the theme's default for the kind. Schema 2.",
          "type": [
            "string",
            "null"
          ]
        },
        "height": {
          "description": "Row height in UI pixels (`MIN_TRACK_HEIGHT..=MAX_TRACK_HEIGHT`); `None` = the view's default for the kind. Schema 2.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "hidden": {
          "description": "Out of the output entirely (eye off): neither drawn nor heard. Added in schema 2; absent = false.",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/TrackId"
        },
        "kind": {
          "$ref": "#/$defs/TrackKind"
        },
        "locked": {
          "type": "boolean"
        },
        "muted": {
          "description": "Silent (audio) / not drawn (video). The track keeps its clips and its place in the stack.",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "solo": {
          "description": "While any track of a kind is soloed, only the soloed tracks of that kind are drawn / heard. Schema 2; absent = false.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "muted",
        "locked",
        "clips"
      ]
    },
    "TrackId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "TrackKind": {
      "type": "string",
      "enum": [
        "video",
        "audio"
      ]
    }
  }
}
